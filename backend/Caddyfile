{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
	order mercure after encode
}

:80 {
	encode zstd gzip

	mercure {
		# Mercure protocol 1.0: tokens are RFC 9068 access JWTs minted by the backend
		# (Ukolio\Service\Realtime\MercureAccessToken) with iss "ukolio" and aud set to the
		# resource identifier below, which docker-entrypoint.sh derives from MERCURE_PUBLISH_URL.
		issuer ukolio {
			publisher {
				jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
			}
			subscriber {
				jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
			}
		}
		resource_identifier {$MERCURE_RESOURCE_IDENTIFIER}
		# The backend sets this HttpOnly cookie (MercureCookieIssuer); a prefix-less name keeps
		# it working over plain HTTP in development.
		cookie_name mercureAuthorization
		# No wildcard fallback: a missing value fails closed instead of
		# leaving the realtime hub open to any origin.
		cors_origins {$BACKEND_CORS_ALLOWED_ORIGIN}
	}

	php {
		root /app/src
		worker {
			file frankenphp-worker.php
			num {$BACKEND_FRANKENPHP_WORKERS:4}
			match *
		}
	}
}
